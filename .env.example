# ==========================================
# AriaBox Environment Configuration
# ==========================================
# It is highly recommended to use this .env file to store
# your configuration and secrets securely, rather than
# hardcoding them in compose.yml.
#
# To use: Copy this file to .env and update the values.
# cp .env.example .env

# App Settings
DATA_DIR=/app/data
DEFAULT_LANGUAGE=en
DEFAULT_LOCATION=US

# Host and Port
HOST_URL="0.0.0.0"
HOST_PORT="8960"

# Security
# you can generate one using following command:
# python -c "import secrets; print(secrets.token_hex())"
SECRET_KEY="change_me_please"

# ==========================================
# Docker / Podman User Mapping
# ==========================================
# For standard Rootful Docker: Leave these commented out.
# The container will safely run as the non-root 'ariabox' user (UID 1000).
#
# For Rootless Docker / Podman: Uncomment the lines below and set them to 0.
# This safely maps the container's "root" to your actual host user,
# fixing all volume permission issues!
# PUID=0
# PGID=0
